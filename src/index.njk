  <script>
    // Apply a saved light/dark choice before first paint. No attribute = follow the OS.
    try {
      var t = localStorage.getItem("theme");
      if (t === "light" || t === "dark") document.documentElement.dataset.theme = t;
    } catch (e) {}
  </script>
  <style>
{% include "styles.css" %}
  </style>
</head>
<body>
  <canvas id="nodes" aria-hidden="true"></canvas>
  <script>
    // Background: slow drifting nodes, linked by faint lines when close.
    // Runs right after the canvas (not at the end of body) so the first frame is drawn before content paints.
    (function () {
      var canvas = document.getElementById("nodes");
      var ctx = canvas.getContext && canvas.getContext("2d");
      if (!ctx) return;

      var LINK = 150; // max distance (px) for a connecting line
      var DENSITY = 15000; // one node per this many square px
      var MAX_NODES = 90;
      var ACCENTS = ["--red", "--amber", "--teal", "--violet"];
      var still = matchMedia("(prefers-reduced-motion: reduce)");
      var nodes = [];
      var w = 0, h = 0, raf = 0, last = 0;
      var ink = "#888", accents = [];

      function readColors() {
        var css = getComputedStyle(document.documentElement);
        ink = css.getPropertyValue("--text").trim();
        accents = ACCENTS.map(function (v) { return css.getPropertyValue(v).trim(); });
      }

      function makeNode() {
        var angle = Math.random() * Math.PI * 2;
        var speed = 0.004 + Math.random() * 0.01; // px per ms, roughly 4-14 px/s
        return {
          x: Math.random() * w,
          y: Math.random() * h,
          vx: Math.cos(angle) * speed,
          vy: Math.sin(angle) * speed,
          r: 1 + Math.random() * 1.3,
          accent: Math.random() < 0.18 ? Math.floor(Math.random() * ACCENTS.length) : -1,
        };
      }

      function resize() {
        var dpr = Math.min(window.devicePixelRatio || 1, 2);
        w = window.innerWidth;
        h = window.innerHeight;
        canvas.width = Math.round(w * dpr);
        canvas.height = Math.round(h * dpr);
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        var target = Math.min(MAX_NODES, Math.round((w * h) / DENSITY));
        while (nodes.length < target) nodes.push(makeNode());
        nodes.length = target;
        nodes.forEach(function (n) {
          n.x = Math.min(n.x, w);
          n.y = Math.min(n.y, h);
        });
      }

      function step(dt) {
        var pad = 20;
        nodes.forEach(function (n) {
          n.x += n.vx * dt;
          n.y += n.vy * dt;
          if (n.x < -pad) n.x = w + pad;
          else if (n.x > w + pad) n.x = -pad;
          if (n.y < -pad) n.y = h + pad;
          else if (n.y > h + pad) n.y = -pad;
        });
      }

      function draw() {
        ctx.clearRect(0, 0, w, h);
        ctx.lineWidth = 1;
        ctx.strokeStyle = ink;
        for (var i = 0; i < nodes.length; i++) {
          for (var j = i + 1; j < nodes.length; j++) {
            var dx = nodes[i].x - nodes[j].x;
            var dy = nodes[i].y - nodes[j].y;
            var d2 = dx * dx + dy * dy;
            if (d2 > LINK * LINK) continue;
            ctx.globalAlpha = (1 - Math.sqrt(d2) / LINK) * 0.13;
            ctx.beginPath();
            ctx.moveTo(nodes[i].x, nodes[i].y);
            ctx.lineTo(nodes[j].x, nodes[j].y);
            ctx.stroke();
          }
        }
        nodes.forEach(function (n) {
          ctx.globalAlpha = n.accent < 0 ? 0.3 : 0.7;
          ctx.fillStyle = n.accent < 0 ? ink : accents[n.accent];
          ctx.beginPath();
          ctx.arc(n.x, n.y, n.accent < 0 ? n.r : n.r + 0.6, 0, Math.PI * 2);
          ctx.fill();
        });
        ctx.globalAlpha = 1;
      }

      function frame(t) {
        step(Math.max(0, Math.min(t - last, 50)));
        last = t;
        draw();
        raf = requestAnimationFrame(frame);
      }

      function start() {
        cancelAnimationFrame(raf);
        raf = 0;
        draw();
        if (still.matches || document.hidden) return;
        last = performance.now();
        raf = requestAnimationFrame(frame);
      }

      function restyle() {
        readColors();
        if (!raf) draw();
      }

      readColors();
      resize();
      start();

      var resizeTimer = 0;
      window.addEventListener("resize", function () {
        clearTimeout(resizeTimer);
        resizeTimer = setTimeout(function () {
          resize();
          if (!raf) draw();
        }, 100);
      });
      document.addEventListener("visibilitychange", start);
      still.addEventListener("change", start);
      matchMedia("(prefers-color-scheme: dark)").addEventListener("change", restyle);
      new MutationObserver(restyle).observe(document.documentElement, { attributes: true, attributeFilter: ["data-theme"] });
    })();
  </script>
  <header class="topbar">
    <a class="wordmark" href="/">mpeyfuss</a>
    <div class="theme-switch" role="group" aria-label="Theme">
      <button type="button" data-choice="system">System</button>
      <button type="button" data-choice="light">Light</button>
      <button type="button" data-choice="dark">Dark</button>
    </div>
  </header>

  <main>
    <div class="hero">
      <div>
        <h1>Marco Peyfuss</h1>
        <p class="lede">I build software where art, technology, and the blockchain meet, and I help creators turn ambitious ideas into things that ship.</p>
        <div class="links">
          {%- for s in socials %}
          <a class="button{% if loop.first %} primary{% endif %}" href="{{ s.url }}" target="_blank" rel="noopener noreferrer">{{ s.label }} {{ arrow | safe }}</a>
          {%- endfor %}
        </div>
      </div>
      <div class="pfp">
        <img src="/assets/pfp.png" width="460" height="460" alt="A hand-drawn sketch of Marco smiling at a laptop" />
      </div>
    </div>

    <section aria-labelledby="focus">
      <div class="section-head"><span class="num">01</span><h2 id="focus">What I like to work on</h2></div>
      <div class="focus">
        {%- for f in focus %}
        <div class="card" style="--accent: {{ f.accent }}">
          <h3>{{ f.title }}</h3>
          <p>{{ f.body }}</p>
          <ul class="tags">{% for t in f.tags %}<li>{{ t }}</li>{% endfor %}</ul>
        </div>
        {%- endfor %}
      </div>
    </section>

    <section aria-labelledby="now">
      <div class="section-head"><span class="num">02</span><h2 id="now">Currently</h2></div>
      <div class="card feature">
        <div>
          <h3>Transient Labs</h3>
          <p>We build an open marketplace where artists self-publish and sell their digital work, plus the contracts and tooling underneath it.</p>
          <p>The focus is on how creators can use software and the blockchain to push their work further.</p>
          <div class="links">
            <a class="button" href="https://transient.xyz" target="_blank" rel="noopener noreferrer">transient.xyz {{ arrow | safe }}</a>
          </div>
        </div>
        <dl class="stats">
          <div class="stat"><dt>Artist sales</dt><dd>$20M+</dd></div>
          <div class="stat"><dt>Started as</dt><dd>Two friends messing around with art</dd></div>
        </dl>
      </div>
    </section>

    <section aria-labelledby="projects">
      <div class="section-head"><span class="num">03</span><h2 id="projects">Projects</h2></div>
      <div class="projects">
        {%- for p in projects %}
        <a class="card project" href="{{ p.url }}" target="_blank" rel="noopener noreferrer">
          <div class="project-head"><h3>{{ p.name }}</h3>{{ arrow | safe }}</div>
          <p>{{ p.body }}</p>
          <ul class="tags">{% for t in p.tags %}<li>{{ t }}</li>{% endfor %}</ul>
        </a>
        {%- endfor %}
      </div>
    </section>

    <section aria-labelledby="background">
      <div class="section-head"><span class="num">04</span><h2 id="background">Background</h2></div>
      <p class="muted" style="max-width: 40em; margin-bottom: 8px;">I started out in mechanical engineering, worked on cars and spacecraft, then found my way to smart contracts and never left.</p>
      <ol class="timeline">
        {%- for b in background %}
        <li><div class="when">{{ b.when }}</div><div><strong>{{ b.what }}</strong><span>{{ b.detail }}</span></div></li>
        {%- endfor %}
      </ol>
    </section>
  </main>

  <footer>
    <div class="footer-inner">
      <span>© {% year %} Marco Peyfuss</span>
      <nav aria-label="Elsewhere">
        {%- for s in socials %}
        <a href="{{ s.url }}" target="_blank" rel="noopener noreferrer">{{ s.label }}</a>
        {%- endfor %}
      </nav>
    </div>
  </footer>

  <script>
    (function () {
      var root = document.documentElement;
      var buttons = document.querySelectorAll(".theme-switch button");
      function current() {
        return root.dataset.theme || "system";
      }
      function sync() {
        buttons.forEach(function (b) {
          b.setAttribute("aria-pressed", String(b.dataset.choice === current()));
        });
      }
      buttons.forEach(function (b) {
        b.addEventListener("click", function () {
          var choice = b.dataset.choice;
          try {
            if (choice === "system") localStorage.removeItem("theme");
            else localStorage.setItem("theme", choice);
          } catch (e) {}
          if (choice === "system") delete root.dataset.theme;
          else root.dataset.theme = choice;
          sync();
        });
      });
      sync();
    })();
  </script>
</body>
</html>
